# Project Ease — Frontend environment variables
#
# Copy this file to `.env` in this same folder. Vite only exposes variables
# prefixed VITE_ to browser code (everything else here is a no-op by design).
#
# Not required for local dev — without it, the Admin Dashboard's "Eval Quality"
# panel just shows "Set VITE_ADMIN_EVAL_KEY in your .env to load eval results."
# instead of data. Every other panel/feature works without this file.

# Must match ADMIN_EVAL_API_KEY in app/backend/.env exactly.
VITE_ADMIN_EVAL_KEY=<same-secret-string-as-backend-ADMIN_EVAL_API_KEY>
