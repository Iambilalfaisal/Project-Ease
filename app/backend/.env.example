# Project Ease — Backend environment variables
#
# Copy this file to `.env` in this same folder, then replace every <angle-bracket>
# placeholder below with your real value. Nothing here is required to run the
# app locally — with this file absent, blank, or left exactly as-is, the backend
# boots in "auth-only mode": every core SaaS feature (clients, matters, hearings,
# invoices, staff, etc.) works fully. Each section below just turns on once its
# placeholders are replaced with real credentials — no code changes needed.
#
# Never commit a real, filled-in `.env` — it's already in .gitignore.

# ── Local dev server ──────────────────────────────────────────────────────────
PORT=50505
APP_LOG_LEVEL=INFO
# Semicolon-separated list of allowed CORS origins, e.g. https://app.example.com;https://admin.example.com
ALLOWED_ORIGIN=<leave-blank-for-local-dev>

# ── Azure OpenAI — AI chat, document embeddings, Whisper voice-to-text ──────────
# All required together for the "Ask a Question" chat / document search to work.
# Create at: portal.azure.com -> Azure OpenAI resource -> Deployments
OPENAI_HOST=azure
AZURE_OPENAI_SERVICE=<your-azure-openai-resource-name>
AZURE_OPENAI_CHATGPT_MODEL=gpt-4o-mini
AZURE_OPENAI_CHATGPT_DEPLOYMENT=<your-chat-model-deployment-name>
AZURE_OPENAI_EMB_MODEL_NAME=text-embedding-ada-002
AZURE_OPENAI_EMB_DEPLOYMENT=<your-embedding-model-deployment-name>
AZURE_OPENAI_EMB_DIMENSIONS=1536
# Owner Portal "🎤 Record voice note" on court orders — Whisper deployment name.
AZURE_OPENAI_WHISPER_DEPLOYMENT=<your-whisper-deployment-name>
# Only needed if authenticating with an API key instead of Azure AD / managed identity.
AZURE_OPENAI_API_KEY_OVERRIDE=<your-azure-openai-api-key>

# ── Azure AI Search — hybrid document + case-law (PLD/SCMR) search ──────────────
# Create at: portal.azure.com -> Azure AI Search resource
AZURE_SEARCH_SERVICE=<your-azure-search-resource-name>
AZURE_SEARCH_INDEX=gptkbindex
AZURE_SEARCH_KEY=<your-azure-search-admin-key>

# ── Azure Blob Storage — document library uploads ───────────────────────────────
# Create at: portal.azure.com -> Storage account
AZURE_STORAGE_ACCOUNT=<your-storage-account-name>
AZURE_STORAGE_CONTAINER=content
AZURE_USERSTORAGE_ACCOUNT=<your-user-upload-storage-account-name>
AZURE_USERSTORAGE_CONTAINER=user-content

# ── Azure AI Document Intelligence — FIR photo/PDF OCR scanning ────────────────
# Create at: portal.azure.com -> Document Intelligence (Form Recognizer) resource
AZURE_DOCUMENTINTELLIGENCE_SERVICE=<your-document-intelligence-resource-name>

# ── Twilio — WhatsApp reminders, morning briefs, court-holiday notices ──────────
# Get these at: console.twilio.com (Account SID + Auth Token on the dashboard)
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
# Default below is Twilio's public WhatsApp Sandbox number — fine for testing;
# replace with your own approved WhatsApp Business sender for production.
TWILIO_WA_FROM=whatsapp:+14155238886

# ── SMTP (Gmail) — team invite / registration / password-reset emails ───────────
# SMTP_APP_PASSWORD is a Google App Password (myaccount.google.com/apppasswords),
# not your normal Gmail account password. Requires 2-Step Verification enabled.
SMTP_EMAIL=<your-gmail-address>@gmail.com
SMTP_APP_PASSWORD=<your-16-character-google-app-password>

# ── Admin "Eval Quality" panel (optional, platform-admin only) ─────────────────
# Any secret string you choose — must match VITE_ADMIN_EVAL_KEY in
# app/frontend/.env exactly for the panel to authenticate.
ADMIN_EVAL_API_KEY=<choose-any-secret-string>

# ── Not an env var — noted here so it isn't missed ──────────────────────────────
# The JazzCash/Easypaisa account numbers shown on the plan-upgrade screen are
# hardcoded placeholder TEXT in app/frontend/src/pages/owner/OwnerPortal.tsx
# (search PLACEHOLDER_JAZZCASH_NO / PLACEHOLDER_EASYPAISA_NO) — update them
# directly in that file when you have real account numbers, not here.
